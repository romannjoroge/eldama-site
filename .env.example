# Bun provisions the only admin account from these backend-only values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_NAME=Eldama Administrator
ADMIN_SESSION_SECRET=change-me-before-production

# Live chat WebSocket server base URL (no path)
VITE_CHAT_WS_URL=ws://127.0.0.1:8787
REALTIME_PORT=8787
REALTIME_HOST=127.0.0.1
CHAT_SERVICE_URL=http://127.0.0.1:8787
CHAT_SERVICE_TOKEN=replace-with-a-long-random-secret
TEST_AGENT_EMAIL=replace-with-email-for-testing
TEST_AGENT_PASSWORD=replace-with-password-for-testing

# Email notifications for new chat conversations (Resend)
# Leave blank to log notifications to stdout instead of emailing.
RESEND_API_KEY=
SUPPORT_EMAIL=help@eldama.co.ke
